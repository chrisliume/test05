# =============================================================================
# Environment Variables for test05
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set for the application to run.
# Variables marked [OPTIONAL] have sensible defaults if left unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# [OPTIONAL] Application environment (development, staging, production)
# Default: development
APP_ENV=development

# [OPTIONAL] Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# [OPTIONAL] Python path — ensures the src package is importable
# Default: . (current directory)
PYTHONPATH=.

# -----------------------------------------------------------------------------
# Future Configuration (uncomment and set as needed)
# -----------------------------------------------------------------------------

# [OPTIONAL] Host and port for a future web server
# HOST=0.0.0.0
# PORT=8000

# [OPTIONAL] Database connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/test05

# [OPTIONAL] Secret key for session/token signing
# SECRET_KEY=change-me-to-a-random-string
